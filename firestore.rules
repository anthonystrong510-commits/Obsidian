rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Core Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isBootstrapAdminEmail() {
      return isVerifiedUser() &&
        (request.auth.token.email == 'obsidianvault99@gmail.com' ||
         request.auth.token.email == 'muokltd@gmail.com');
    }

    function isAdmin() {
      return isVerifiedUser() && (
        isBootstrapAdminEmail() ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Entity Validators
    function isValidUserPublicProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'role', 'status', 'provider', 'walletCount', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'role', 'status', 'provider', 'walletCount', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.role in ['user', 'admin']
        && data.status in ['active', 'suspended', 'kyc_pending']
        && data.provider in ['google', 'password']
        && data.walletCount is number && data.walletCount >= 0 && data.walletCount <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserPrivateInfo(data) {
      return data.keys().hasAll(['uid', 'email', 'currency', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'currency', 'updatedAt'])
        && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 200
        && data.currency in ['USD', 'EUR', 'GBP']
        && data.updatedAt is timestamp;
    }

    function isValidUserWallet(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'name', 'walletType', 'accountIndex', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'name', 'walletType', 'wordCount', 'preset',
          'accountIndex', 'evmAddress', 'solanaAddress', 'bitcoinAddress',
          'moneroAddress', 'encryptedSecret', 'archived', 'archivedAt',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.walletType in ['mnemonic', 'privateKey', 'watchOnly']
        && data.accountIndex is number && data.accountIndex >= 0 && data.accountIndex <= 1000
        && (!('wordCount' in data) || (data.wordCount is number && data.wordCount in [12, 18, 24]))
        && (!('preset' in data) || (data.preset is string && data.preset.size() <= 40))
        && (!('evmAddress' in data) || (data.evmAddress is string && data.evmAddress.size() <= 100))
        && (!('solanaAddress' in data) || (data.solanaAddress is string && data.solanaAddress.size() <= 100))
        && (!('bitcoinAddress' in data) || (data.bitcoinAddress is string && data.bitcoinAddress.size() <= 100))
        && (!('moneroAddress' in data) || (data.moneroAddress is string && data.moneroAddress.size() <= 120))
        && (!('encryptedSecret' in data) || (data.encryptedSecret is string && data.encryptedSecret.size() <= 4096))
        && (!('archived' in data) || data.archived is bool)
        && (!('archivedAt' in data) || data.archivedAt is timestamp)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidConnectedSession(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'providerUuid', 'walletName', 'kind',
          'address', 'platform', 'selectedForSweep', 'connectedAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'providerUuid', 'walletName', 'kind',
          'address', 'chainId', 'platform', 'selectedForSweep', 'connectedAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.providerUuid is string && data.providerUuid.size() >= 1 && data.providerUuid.size() <= 128
        && data.walletName is string && data.walletName.size() >= 1 && data.walletName.size() <= 80
        && data.kind in ['evm', 'solana']
        && data.address is string && data.address.size() >= 10 && data.address.size() <= 120
        && (!('chainId' in data) || (data.chainId is number && data.chainId >= 1 && data.chainId <= 1000000000))
        && data.platform in ['desktop', 'mobile']
        && data.selectedForSweep is bool
        && data.connectedAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAlert(data) {
      return data.keys().hasAll(['id', 'ownerUid', 'coinId', 'symbol', 'name', 'condition', 'targetValue', 'active', 'repeat', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'coinId', 'symbol', 'name', 'condition',
          'targetValue', 'active', 'repeat', 'soundEnabled', 'browserNotification',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.coinId is string && data.coinId.size() >= 1 && data.coinId.size() <= 64
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 20
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 64
        && data.condition in ['above', 'below', 'change24h']
        && data.targetValue is number && data.targetValue > 0
        && data.active is bool
        && data.repeat is bool
        && (!('soundEnabled' in data) || data.soundEnabled is bool)
        && (!('browserNotification' in data) || data.browserNotification is bool)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWalletCatalogItem(data) {
      return data.keys().hasAll([
          'id', 'name', 'ecosystem', 'defaultWords', 'derivationPath',
          'presetId', 'enabled', 'featured', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'ecosystem', 'defaultWords', 'derivationPath',
          'presetId', 'mobileDeepLink', 'badgeColor', 'description',
          'enabled', 'featured', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.ecosystem in ['multi-chain', 'evm', 'solana', 'bitcoin', 'monero']
        && data.defaultWords is number && data.defaultWords in [12, 18, 24]
        && data.derivationPath is string && data.derivationPath.size() >= 1 && data.derivationPath.size() <= 64
        && data.presetId is string && data.presetId.size() >= 1 && data.presetId.size() <= 40
        && (!('mobileDeepLink' in data) || (data.mobileDeepLink is string && data.mobileDeepLink.size() <= 300))
        && (!('badgeColor' in data) || (data.badgeColor is string && data.badgeColor.size() <= 20))
        && (!('description' in data) || (data.description is string && data.description.size() <= 240))
        && data.enabled is bool
        && data.featured is bool
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidExchangeWallet(data) {
      return data.keys().hasAll([
          'id', 'tier', 'label', 'networkFamily', 'quorum',
          'allocationCapPct', 'status', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'tier', 'label', 'networkFamily', 'evmAddress',
          'solanaAddress', 'bitcoinAddress', 'moneroAddress', 'quorum', 'allocationCapPct',
          'status', 'encryptedVaultBlob', 'archivedAt', 'archivedBy', 'createdBy', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.tier in ['cold', 'pool', 'hot']
        && data.label is string && data.label.size() >= 1 && data.label.size() <= 100
        && data.networkFamily in ['multi-chain', 'evm', 'solana', 'bitcoin', 'monero']
        && (!('evmAddress' in data) || (data.evmAddress is string && data.evmAddress.size() <= 100))
        && (!('solanaAddress' in data) || (data.solanaAddress is string && data.solanaAddress.size() <= 100))
        && (!('bitcoinAddress' in data) || (data.bitcoinAddress is string && data.bitcoinAddress.size() <= 100))
        && (!('moneroAddress' in data) || (data.moneroAddress is string && data.moneroAddress.size() <= 120))
        && data.quorum is string && data.quorum.size() >= 1 && data.quorum.size() <= 32
        && data.allocationCapPct is number && data.allocationCapPct >= 0 && data.allocationCapPct <= 100
        && data.status in ['active', 'frozen', 'sweeping', 'archived']
        && (!('encryptedVaultBlob' in data) || (data.encryptedVaultBlob is string && data.encryptedVaultBlob.size() <= 4096))
        && (!('archivedAt' in data) || data.archivedAt is timestamp)
        && (!('archivedBy' in data) || isValidId(data.archivedBy))
        && isValidId(data.createdBy)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminMarker(data) {
      return data.keys().hasAll(['uid', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['uid', 'grantedBy', 'createdAt'])
        && isValidId(data.uid)
        && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidAuditLog(data) {
      return data.keys().hasAll(['id', 'actorUid', 'action', 'targetId', 'summary', 'createdAt'])
        && data.keys().hasOnly(['id', 'actorUid', 'action', 'targetId', 'summary', 'createdAt'])
        && isValidId(data.id)
        && isValidId(data.actorUid)
        && data.action is string && data.action.size() >= 1 && data.action.size() <= 100
        && data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128
        && data.summary is string && data.summary.size() >= 1 && data.summary.size() <= 300
        && data.createdAt is timestamp;
    }

    function isValidSystemConfig(data) {
      return data.keys().hasAll(['maintenanceMode', 'withdrawalsPaused', 'hotWalletMaxPct', 'swapFeeBps', 'updatedBy', 'updatedAt'])
        && data.keys().hasOnly([
          'maintenanceMode', 'withdrawalsPaused', 'hotWalletMaxPct', 'swapFeeBps',
          'sendFeeBps', 'gasSponsorshipEnabled',
          'activeSwapWalletId', 'activeSwapWalletLabel', 'activeSwapWalletAddress',
          'gasSponsorWalletId', 'gasSponsorWalletLabel', 'gasSponsorWalletAddress',
          'feeCollectorWalletId', 'feeCollectorWalletLabel', 'feeCollectorWalletAddress',
          'updatedBy', 'updatedAt'
        ])
        && data.maintenanceMode is bool
        && data.withdrawalsPaused is bool
        && data.hotWalletMaxPct is number && data.hotWalletMaxPct >= 1 && data.hotWalletMaxPct <= 100
        && data.swapFeeBps is number && data.swapFeeBps >= 0 && data.swapFeeBps <= 500
        && (!('sendFeeBps' in data) || (data.sendFeeBps is number && data.sendFeeBps >= 0 && data.sendFeeBps <= 500))
        && (!('gasSponsorshipEnabled' in data) || data.gasSponsorshipEnabled is bool)
        && (!('activeSwapWalletId' in data) || (data.activeSwapWalletId is string && data.activeSwapWalletId.size() <= 128))
        && (!('activeSwapWalletLabel' in data) || (data.activeSwapWalletLabel is string && data.activeSwapWalletLabel.size() <= 100))
        && (!('activeSwapWalletAddress' in data) || (data.activeSwapWalletAddress is string && data.activeSwapWalletAddress.size() <= 120))
        && (!('gasSponsorWalletId' in data) || (data.gasSponsorWalletId is string && data.gasSponsorWalletId.size() <= 128))
        && (!('gasSponsorWalletLabel' in data) || (data.gasSponsorWalletLabel is string && data.gasSponsorWalletLabel.size() <= 100))
        && (!('gasSponsorWalletAddress' in data) || (data.gasSponsorWalletAddress is string && data.gasSponsorWalletAddress.size() <= 120))
        && (!('feeCollectorWalletId' in data) || (data.feeCollectorWalletId is string && data.feeCollectorWalletId.size() <= 128))
        && (!('feeCollectorWalletLabel' in data) || (data.feeCollectorWalletLabel is string && data.feeCollectorWalletLabel.size() <= 100))
        && (!('feeCollectorWalletAddress' in data) || (data.feeCollectorWalletAddress is string && data.feeCollectorWalletAddress.size() <= 120))
        && isValidId(data.updatedBy)
        && data.updatedAt is timestamp;
    }

    function isValidClaimRequest(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'sourceType', 'walletAddress', 'destinationAddress',
          'networkId', 'symbol', 'amount', 'usdValue', 'sourceTxHash',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'sourceType', 'walletAddress', 'destinationAddress',
          'networkId', 'symbol', 'amount', 'usdValue', 'sourceTxHash',
          'status', 'disbursedByWalletId', 'disbursedByWalletLabel',
          'disbursementTxHash', 'note', 'createdAt', 'requestedAt',
          'disbursedAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.sourceType in ['sweep', 'swap']
        && data.walletAddress is string && data.walletAddress.size() >= 4 && data.walletAddress.size() <= 140
        && data.destinationAddress is string && data.destinationAddress.size() >= 4 && data.destinationAddress.size() <= 140
        && data.networkId is string && data.networkId.size() >= 2 && data.networkId.size() <= 32
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 40
        && data.amount is string && data.amount.size() >= 1 && data.amount.size() <= 100
        && data.usdValue is number && data.usdValue >= 0 && data.usdValue <= 100000000000
        && data.sourceTxHash is string && data.sourceTxHash.size() >= 4 && data.sourceTxHash.size() <= 200
        && data.status in ['claimable', 'requested', 'disbursed', 'rejected']
        && (!('disbursedByWalletId' in data) || (data.disbursedByWalletId is string && data.disbursedByWalletId.size() <= 128))
        && (!('disbursedByWalletLabel' in data) || (data.disbursedByWalletLabel is string && data.disbursedByWalletLabel.size() <= 100))
        && (!('disbursementTxHash' in data) || (data.disbursementTxHash is string && data.disbursementTxHash.size() <= 200))
        && (!('note' in data) || (data.note is string && data.note.size() <= 300))
        && data.createdAt is timestamp
        && (!('requestedAt' in data) || data.requestedAt is timestamp)
        && (!('disbursedAt' in data) || data.disbursedAt is timestamp)
        && data.updatedAt is timestamp;
    }

    function isValidFeeGasSettlement(data) {
      return data.keys().hasAll([
          'id', 'ownerUid', 'txType', 'networkId', 'symbol', 'txAmount', 'txUsdValue',
          'sourceWalletAddress', 'recipientAddress', 'gasAmountNative', 'gasSymbol',
          'gasUsdValue', 'gasRequestStatus', 'platformFeeAmount', 'platformFeeSymbol',
          'platformFeeUsdValue', 'feeStatus', 'txHash', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'ownerUid', 'txType', 'networkId', 'symbol', 'txAmount', 'txUsdValue',
          'sourceWalletAddress', 'recipientAddress', 'gasAmountNative', 'gasSymbol',
          'gasUsdValue', 'gasSponsorWalletId', 'gasSponsorWalletLabel', 'gasSponsorAddress',
          'gasRequestStatus', 'platformFeeAmount', 'platformFeeSymbol', 'platformFeeUsdValue',
          'feeCollectorWalletId', 'feeCollectorWalletLabel', 'feeCollectorAddress',
          'feeStatus', 'txHash', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerUid)
        && data.txType in ['send', 'receive', 'swap', 'sweep']
        && data.networkId is string && data.networkId.size() >= 2 && data.networkId.size() <= 32
        && data.symbol is string && data.symbol.size() >= 1 && data.symbol.size() <= 40
        && data.txAmount is string && data.txAmount.size() >= 1 && data.txAmount.size() <= 100
        && data.txUsdValue is number && data.txUsdValue >= 0 && data.txUsdValue <= 100000000000
        && data.sourceWalletAddress is string && data.sourceWalletAddress.size() >= 4 && data.sourceWalletAddress.size() <= 140
        && data.recipientAddress is string && data.recipientAddress.size() >= 4 && data.recipientAddress.size() <= 140
        && data.gasAmountNative is string && data.gasAmountNative.size() >= 1 && data.gasAmountNative.size() <= 64
        && data.gasSymbol is string && data.gasSymbol.size() >= 1 && data.gasSymbol.size() <= 24
        && data.gasUsdValue is number && data.gasUsdValue >= 0 && data.gasUsdValue <= 10000000
        && (!('gasSponsorWalletId' in data) || (data.gasSponsorWalletId is string && data.gasSponsorWalletId.size() <= 128))
        && (!('gasSponsorWalletLabel' in data) || (data.gasSponsorWalletLabel is string && data.gasSponsorWalletLabel.size() <= 100))
        && (!('gasSponsorAddress' in data) || (data.gasSponsorAddress is string && data.gasSponsorAddress.size() <= 140))
        && data.gasRequestStatus in ['requested', 'sponsored', 'settled']
        && data.platformFeeAmount is string && data.platformFeeAmount.size() >= 1 && data.platformFeeAmount.size() <= 64
        && data.platformFeeSymbol is string && data.platformFeeSymbol.size() >= 1 && data.platformFeeSymbol.size() <= 24
        && data.platformFeeUsdValue is number && data.platformFeeUsdValue >= 0 && data.platformFeeUsdValue <= 100000000
        && (!('feeCollectorWalletId' in data) || (data.feeCollectorWalletId is string && data.feeCollectorWalletId.size() <= 128))
        && (!('feeCollectorWalletLabel' in data) || (data.feeCollectorWalletLabel is string && data.feeCollectorWalletLabel.size() <= 100))
        && (!('feeCollectorAddress' in data) || (data.feeCollectorAddress is string && data.feeCollectorAddress.size() <= 140))
        && data.feeStatus in ['pending', 'collected']
        && data.txHash is string && data.txHash.size() >= 4 && data.txHash.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // Users Collection & Isolated PII Subcollection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().role == 'user'
        && incoming().status == 'active'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isValidUserPublicProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().provider == existing().provider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin() && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'role', 'status', 'walletCount', 'updatedAt'])) ||
          (isOwner(userId)
            && incoming().role == existing().role
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'walletCount', 'updatedAt']))
        );

      allow delete: if isValidId(userId) && isAdmin();

      // Isolated PII subcollection
      match /private/{docId} {
        allow get: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isAdmin();
        allow create: if isValidId(userId) && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == request.auth.uid
          && incoming().updatedAt == request.time;
        allow update: if isValidId(userId) && isValidId(docId)
          && isOwner(userId)
          && isValidUserPrivateInfo(incoming())
          && incoming().uid == existing().uid
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['email', 'currency', 'updatedAt']);
        allow delete: if isValidId(userId) && isValidId(docId) && (isOwner(userId) || isAdmin());
      }

      // User Encrypted Wallets (Owner or Admin provisioning)
      match /wallets/{walletId} {
        allow get: if isValidId(userId) && isValidId(walletId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == userId && resource.data.ownerUid == request.auth.uid));

        allow create: if isValidId(userId) && isValidId(walletId)
          && (isOwner(userId) || isAdmin())
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserWallet(incoming())
          && incoming().id == walletId
          && incoming().ownerUid == userId
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(walletId)
          && (isOwner(userId) || isAdmin())
          && isValidUserWallet(incoming())
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().walletType == existing().walletType
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (!('moneroAddress' in existing()) || incoming().moneroAddress == existing().moneroAddress)
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'encryptedSecret', 'moneroAddress', 'archived', 'archivedAt', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(walletId) && (isOwner(userId) || isAdmin());
      }

      // Concurrent WalletConnect & Mobile dApp Sessions
      match /connected_sessions/{sessionId} {
        allow get: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && (isAdmin() || (isVerifiedUser() && request.auth.uid == userId && resource.data.ownerUid == request.auth.uid));

        allow create: if isValidId(userId) && isValidId(sessionId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidConnectedSession(incoming())
          && incoming().id == sessionId
          && incoming().ownerUid == request.auth.uid
          && incoming().connectedAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(sessionId)
          && isOwner(userId)
          && isValidConnectedSession(incoming())
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().connectedAt == existing().connectedAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['chainId', 'selectedForSweep', 'walletName', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(sessionId) && (isOwner(userId) || isAdmin());
      }

      // User Price Alerts
      match /alerts/{alertId} {
        allow get: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
        allow list: if isValidId(userId) && isVerifiedUser() && (request.auth.uid == userId && resource.data.ownerUid == request.auth.uid);

        allow create: if isValidId(userId) && isValidId(alertId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidUserAlert(incoming())
          && incoming().id == alertId
          && incoming().ownerUid == request.auth.uid
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(alertId)
          && isOwner(userId)
          && isValidUserAlert(incoming())
          && incoming().id == existing().id
          && incoming().ownerUid == existing().ownerUid
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['active', 'targetValue', 'repeat', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(alertId) && (isOwner(userId) || isAdmin());
      }
    }

    // Admin-Managed Wallet Directory (Readable if enabled or Admin; Writable only by Admin)
    match /wallet_catalog/{walletId} {
      allow get: if isValidId(walletId) && (isAdmin() || (isVerifiedUser() && existing().enabled == true));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.enabled == true);

      allow create: if isValidId(walletId)
        && isAdmin()
        && isValidWalletCatalogItem(incoming())
        && incoming().id == walletId
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(walletId)
        && isAdmin()
        && isValidWalletCatalogItem(incoming())
        && incoming().id == existing().id
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'name', 'ecosystem', 'defaultWords', 'derivationPath', 'presetId',
          'mobileDeepLink', 'badgeColor', 'description', 'enabled', 'featured', 'updatedAt'
        ]);

      allow delete: if isValidId(walletId) && isAdmin();
    }

    // Trusted Admin Registry
    match /admins/{adminUid} {
      allow get: if isValidId(adminUid) && (isOwner(adminUid) || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(adminUid)
        && isAdmin()
        && isValidAdminMarker(incoming())
        && incoming().uid == adminUid
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if false;
      allow delete: if isValidId(adminUid) && isAdmin();
    }

    // Exchange Treasury Wallets (Cold, Pool, Hot — Archive-Only, Deletion Strictly Forbidden)
    match /exchange_wallets/{walletId} {
      allow get: if isValidId(walletId) && isAdmin();
      allow list: if isAdmin();

      allow create: if isValidId(walletId)
        && isAdmin()
        && isValidExchangeWallet(incoming())
        && incoming().id == walletId
        && incoming().status != 'archived'
        && !('archivedAt' in incoming())
        && !('archivedBy' in incoming())
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(walletId)
        && isAdmin()
        && isValidExchangeWallet(incoming())
        && incoming().id == existing().id
        && incoming().tier == existing().tier
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (existing().status != 'archived' || incoming().status == 'archived')
        && (!('archivedAt' in existing()) || incoming().archivedAt == existing().archivedAt)
        && (!('archivedBy' in existing()) || incoming().archivedBy == existing().archivedBy)
        && (
          incoming().status != 'archived' ||
          existing().status == 'archived' ||
          (incoming().archivedAt == request.time && incoming().archivedBy == request.auth.uid)
        )
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'label', 'quorum', 'allocationCapPct', 'status',
          'encryptedVaultBlob', 'archivedAt', 'archivedBy', 'updatedAt'
        ]);

      allow delete: if false;
    }

    // Immutable Admin Audit Logs
    match /admin_audit_logs/{logId} {
      allow get: if isValidId(logId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(logId)
        && isAdmin()
        && isValidAuditLog(incoming())
        && incoming().id == logId
        && incoming().actorUid == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // Global Exchange System Configuration
    match /system_config/{configId} {
      allow get: if isValidId(configId) && (isVerifiedUser() || isAdmin());
      allow list: if false;
      allow create, update: if isValidId(configId)
        && isAdmin()
        && isValidSystemConfig(incoming())
        && incoming().updatedBy == request.auth.uid
        && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // Sweep & Swap Fund Claims and Admin Disbursements
    match /claim_requests/{claimId} {
      allow get: if isValidId(claimId) && (isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(claimId)
        && isVerifiedUser()
        && isValidClaimRequest(incoming())
        && incoming().id == claimId
        && incoming().ownerUid == request.auth.uid
        && incoming().status in ['claimable', 'requested']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && !('disbursedByWalletId' in incoming())
        && !('disbursementTxHash' in incoming())
        && !('disbursedAt' in incoming());

      allow update: if isValidId(claimId)
        && isValidClaimRequest(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().sourceType == existing().sourceType
        && incoming().walletAddress == existing().walletAddress
        && incoming().sourceTxHash == existing().sourceTxHash
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (isAdmin()
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'destinationAddress', 'disbursedByWalletId',
              'disbursedByWalletLabel', 'disbursementTxHash', 'note',
              'disbursedAt', 'updatedAt'
            ])) ||
          (isVerifiedUser()
            && existing().ownerUid == request.auth.uid
            && existing().status in ['claimable', 'requested']
            && incoming().status == 'requested'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'destinationAddress', 'note', 'requestedAt', 'updatedAt'
            ]))
        );

      allow delete: if isValidId(claimId) && isAdmin();
    }

    // Automatic Gas Sponsorship & Nominated Fee Collector Ledger
    match /fee_gas_settlements/{settlementId} {
      allow get: if isValidId(settlementId) && (isAdmin() || (isVerifiedUser() && existing().ownerUid == request.auth.uid));
      allow list: if isAdmin() || (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(settlementId)
        && isVerifiedUser()
        && isValidFeeGasSettlement(incoming())
        && incoming().id == settlementId
        && incoming().ownerUid == request.auth.uid
        && incoming().gasRequestStatus in ['requested', 'sponsored']
        && incoming().feeStatus in ['pending', 'collected']
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(settlementId)
        && isAdmin()
        && isValidFeeGasSettlement(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().txType == existing().txType
        && incoming().txHash == existing().txHash
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'gasRequestStatus', 'feeStatus', 'gasSponsorWalletId',
          'gasSponsorWalletLabel', 'gasSponsorAddress',
          'feeCollectorWalletId', 'feeCollectorWalletLabel', 'feeCollectorAddress',
          'updatedAt'
        ]);

      allow delete: if false;
    }
  }
}

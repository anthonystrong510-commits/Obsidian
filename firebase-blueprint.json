{
  "entities": {
    "UserPublicProfile": {
      "title": "UserPublicProfile",
      "description": "Non-PII user account metadata and role/status visible to owner and admins",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "role": { "type": "string", "enum": ["user", "admin"] },
        "status": { "type": "string", "enum": ["active", "suspended", "kyc_pending"] },
        "provider": { "type": "string", "enum": ["google", "password"] },
        "walletCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "role", "status", "provider", "walletCount", "createdAt", "updatedAt"]
    },
    "UserPrivateInfo": {
      "title": "UserPrivateInfo",
      "description": "Isolated PII document containing user email and preferences",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 200 },
        "currency": { "type": "string", "enum": ["USD", "EUR", "GBP"] },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "currency", "updatedAt"]
    },
    "EncryptedUserWallet": {
      "title": "EncryptedUserWallet",
      "description": "Client-side AES-GCM encrypted wallet metadata and public derived addresses",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "walletType": { "type": "string", "enum": ["mnemonic", "privateKey", "watchOnly"] },
        "wordCount": { "type": "number" },
        "preset": { "type": "string", "maxLength": 40 },
        "accountIndex": { "type": "number" },
        "evmAddress": { "type": "string", "maxLength": 100 },
        "solanaAddress": { "type": "string", "maxLength": 100 },
        "bitcoinAddress": { "type": "string", "maxLength": 100 },
        "moneroAddress": { "type": "string", "maxLength": 120 },
        "encryptedSecret": { "type": "string", "maxLength": 4096 },
        "archived": { "type": "boolean" },
        "archivedAt": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "name", "walletType", "accountIndex", "createdAt", "updatedAt"]
    },
    "ConnectedWalletSession": {
      "title": "ConnectedWalletSession",
      "description": "Active external WalletConnect or mobile dApp session metadata for multi-wallet sweep",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "providerUuid": { "type": "string", "minLength": 1, "maxLength": 128 },
        "walletName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "type": "string", "enum": ["evm", "solana"] },
        "address": { "type": "string", "minLength": 10, "maxLength": 120 },
        "chainId": { "type": "number" },
        "platform": { "type": "string", "enum": ["desktop", "mobile"] },
        "selectedForSweep": { "type": "boolean" },
        "connectedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "providerUuid", "walletName", "kind", "address", "platform", "selectedForSweep", "connectedAt", "updatedAt"]
    },
    "UserPriceAlert": {
      "title": "UserPriceAlert",
      "description": "Real-time price alert rule configured by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "coinId": { "type": "string", "minLength": 1, "maxLength": 64 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 20 },
        "name": { "type": "string", "minLength": 1, "maxLength": 64 },
        "condition": { "type": "string", "enum": ["above", "below", "change24h"] },
        "targetValue": { "type": "number" },
        "active": { "type": "boolean" },
        "repeat": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "coinId", "symbol", "name", "condition", "targetValue", "active", "repeat", "createdAt", "updatedAt"]
    },
    "WalletCatalogItem": {
      "title": "WalletCatalogItem",
      "description": "Admin-managed supported wallet provider directory shown during import and mobile connect",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "ecosystem": { "type": "string", "enum": ["multi-chain", "evm", "solana", "bitcoin", "monero"] },
        "defaultWords": { "type": "number" },
        "derivationPath": { "type": "string", "minLength": 1, "maxLength": 64 },
        "presetId": { "type": "string", "minLength": 1, "maxLength": 40 },
        "mobileDeepLink": { "type": "string", "maxLength": 300 },
        "badgeColor": { "type": "string", "maxLength": 20 },
        "description": { "type": "string", "maxLength": 240 },
        "enabled": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ecosystem", "defaultWords", "derivationPath", "presetId", "enabled", "featured", "createdBy", "createdAt", "updatedAt"]
    },
    "ExchangeTreasuryWallet": {
      "title": "ExchangeTreasuryWallet",
      "description": "Exchange-grade Cold, Pool, or Hot custody wallet managed by admins",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "tier": { "type": "string", "enum": ["cold", "pool", "hot"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 100 },
        "networkFamily": { "type": "string", "enum": ["multi-chain", "evm", "solana", "bitcoin", "monero"] },
        "evmAddress": { "type": "string", "maxLength": 100 },
        "solanaAddress": { "type": "string", "maxLength": 100 },
        "bitcoinAddress": { "type": "string", "maxLength": 100 },
        "moneroAddress": { "type": "string", "maxLength": 120 },
        "quorum": { "type": "string", "minLength": 1, "maxLength": 32 },
        "allocationCapPct": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "frozen", "sweeping", "archived"] },
        "encryptedVaultBlob": { "type": "string", "maxLength": 4096 },
        "archivedAt": { "type": "string", "format": "date-time" },
        "archivedBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdBy": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tier", "label", "networkFamily", "quorum", "allocationCapPct", "status", "createdBy", "createdAt", "updatedAt"]
    },
    "AdminRoleMarker": {
      "title": "AdminRoleMarker",
      "description": "Trusted marker document granting admin privileges to a UID",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "grantedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "grantedBy", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Immutable administrative action log for exchange treasury and user management",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "actorUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "action": { "type": "string", "minLength": 1, "maxLength": 100 },
        "targetId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "actorUid", "action", "targetId", "summary", "createdAt"]
    },
    "ExchangeSystemConfig": {
      "title": "ExchangeSystemConfig",
      "description": "Global exchange operational parameters controlled by admins",
      "type": "object",
      "properties": {
        "maintenanceMode": { "type": "boolean" },
        "withdrawalsPaused": { "type": "boolean" },
        "hotWalletMaxPct": { "type": "number" },
        "swapFeeBps": { "type": "number" },
        "activeSwapWalletId": { "type": "string", "maxLength": 128 },
        "activeSwapWalletLabel": { "type": "string", "maxLength": 100 },
        "activeSwapWalletAddress": { "type": "string", "maxLength": 120 },
        "gasSponsorWalletId": { "type": "string", "maxLength": 128 },
        "gasSponsorWalletLabel": { "type": "string", "maxLength": 100 },
        "gasSponsorWalletAddress": { "type": "string", "maxLength": 120 },
        "feeCollectorWalletId": { "type": "string", "maxLength": 128 },
        "feeCollectorWalletLabel": { "type": "string", "maxLength": 100 },
        "feeCollectorWalletAddress": { "type": "string", "maxLength": 120 },
        "sendFeeBps": { "type": "number" },
        "gasSponsorshipEnabled": { "type": "boolean" },
        "updatedBy": { "type": "string", "minLength": 1, "maxLength": 128 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["maintenanceMode", "withdrawalsPaused", "hotWalletMaxPct", "swapFeeBps", "updatedBy", "updatedAt"]
    },
    "ClaimRequest": {
      "title": "ClaimRequest",
      "description": "Persistent sweep or swap claim entitlement and admin disbursement record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "sourceType": { "type": "string", "enum": ["sweep", "swap"] },
        "walletAddress": { "type": "string", "minLength": 4, "maxLength": 140 },
        "destinationAddress": { "type": "string", "minLength": 4, "maxLength": 140 },
        "networkId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 40 },
        "amount": { "type": "string", "minLength": 1, "maxLength": 100 },
        "usdValue": { "type": "number" },
        "sourceTxHash": { "type": "string", "minLength": 4, "maxLength": 200 },
        "status": { "type": "string", "enum": ["claimable", "requested", "disbursed", "rejected"] },
        "disbursedByWalletId": { "type": "string", "maxLength": 128 },
        "disbursedByWalletLabel": { "type": "string", "maxLength": 100 },
        "disbursementTxHash": { "type": "string", "maxLength": 200 },
        "note": { "type": "string", "maxLength": 300 },
        "createdAt": { "type": "string", "format": "date-time" },
        "requestedAt": { "type": "string", "format": "date-time" },
        "disbursedAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "sourceType", "walletAddress", "destinationAddress", "networkId", "symbol", "amount", "usdValue", "sourceTxHash", "status", "createdAt", "updatedAt"]
    },
    "FeeGasSettlement": {
      "title": "FeeGasSettlement",
      "description": "Automatic network gas sponsorship request and nominated fee wallet collection record for Send, Receive, Swap, and Sweep transactions",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "txType": { "type": "string", "enum": ["send", "receive", "swap", "sweep"] },
        "networkId": { "type": "string", "minLength": 2, "maxLength": 32 },
        "symbol": { "type": "string", "minLength": 1, "maxLength": 40 },
        "txAmount": { "type": "string", "minLength": 1, "maxLength": 100 },
        "txUsdValue": { "type": "number" },
        "sourceWalletAddress": { "type": "string", "minLength": 4, "maxLength": 140 },
        "recipientAddress": { "type": "string", "minLength": 4, "maxLength": 140 },
        "gasAmountNative": { "type": "string", "minLength": 1, "maxLength": 64 },
        "gasSymbol": { "type": "string", "minLength": 1, "maxLength": 24 },
        "gasUsdValue": { "type": "number" },
        "gasSponsorWalletId": { "type": "string", "maxLength": 128 },
        "gasSponsorWalletLabel": { "type": "string", "maxLength": 100 },
        "gasSponsorAddress": { "type": "string", "maxLength": 140 },
        "gasRequestStatus": { "type": "string", "enum": ["requested", "sponsored", "settled"] },
        "platformFeeAmount": { "type": "string", "minLength": 1, "maxLength": 64 },
        "platformFeeSymbol": { "type": "string", "minLength": 1, "maxLength": 24 },
        "platformFeeUsdValue": { "type": "number" },
        "feeCollectorWalletId": { "type": "string", "maxLength": 128 },
        "feeCollectorWalletLabel": { "type": "string", "maxLength": 100 },
        "feeCollectorAddress": { "type": "string", "maxLength": 140 },
        "feeStatus": { "type": "string", "enum": ["pending", "collected"] },
        "txHash": { "type": "string", "minLength": 4, "maxLength": 200 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerUid", "txType", "networkId", "symbol", "txAmount", "txUsdValue", "sourceWalletAddress", "recipientAddress", "gasAmountNative", "gasSymbol", "gasUsdValue", "gasRequestStatus", "platformFeeAmount", "platformFeeSymbol", "platformFeeUsdValue", "feeStatus", "txHash", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublicProfile" },
      "description": "User profile document with status and role"
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivateInfo" },
      "description": "Isolated user PII such as email and currency preference"
    },
    "/users/{userId}/wallets/{walletId}": {
      "schema": { "$ref": "#/entities/EncryptedUserWallet" },
      "description": "Client-encrypted or admin-provisioned user wallets synced across devices"
    },
    "/users/{userId}/connected_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ConnectedWalletSession" },
      "description": "Per-user concurrent WalletConnect and mobile dApp connections"
    },
    "/users/{userId}/alerts/{alertId}": {
      "schema": { "$ref": "#/entities/UserPriceAlert" },
      "description": "User real-time price alerts"
    },
    "/wallet_catalog/{walletId}": {
      "schema": { "$ref": "#/entities/WalletCatalogItem" },
      "description": "Admin-managed directory of supported wallets shown during import and mobile connect"
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRoleMarker" },
      "description": "Trusted admin UID registry"
    },
    "/exchange_wallets/{walletId}": {
      "schema": { "$ref": "#/entities/ExchangeTreasuryWallet" },
      "description": "Exchange cold, pool, and hot custody wallets"
    },
    "/admin_audit_logs/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Immutable administrative audit trail"
    },
    "/system_config/{configId}": {
      "schema": { "$ref": "#/entities/ExchangeSystemConfig" },
      "description": "Global exchange operational settings"
    },
    "/claim_requests/{claimId}": {
      "schema": { "$ref": "#/entities/ClaimRequest" },
      "description": "Sweep and swap fund claims requested by users and disbursed by exchange admins"
    },
    "/fee_gas_settlements/{settlementId}": {
      "schema": { "$ref": "#/entities/FeeGasSettlement" },
      "description": "Automatic gas sponsorship requests and platform fee credits routed to nominated admin wallets"
    }
  }
}
